<%# Scorers' verdicts on this run, and a way to judge it now. locals: run %>
<% results = run.scorer_results.includes(:scorer, :judge_run).to_a
   applicable = Harbor.scorer_class.applicable_to(run) %>
<section id="run-scores" class="mb-8">
  <h2 class="text-sm font-medium text-soft uppercase tracking-[0.05em] mb-3 flex items-center gap-3">
    Scores
    <% if run.scorable? && applicable.any? %>
      <%= form_with url: score_run_path(run), method: :post, class: "ml-auto flex items-center gap-2" do |form| %>
        <%= form.select :scorer_id, [ [ "every applicable scorer", "" ] ] + applicable.map { |s| [ s.name, s.id ] }, {}, class: "field !py-1 text-xs", aria: { label: "Scorer" } %>
        <%= form.submit "Score now", class: "btn-quiet !py-1 !px-3 text-xs cursor-pointer" %>
      <% end %>
    <% end %>
  </h2>
  <% if results.empty? %>
    <p class="text-sm text-faint">Not judged yet<%= applicable.any? ? " — #{applicable.size} scorer(s) apply." : "." %></p>
  <% else %>
    <ul class="card divide-y divide-hairline overflow-hidden">
      <% results.each do |r| %>
        <li id="<%= dom_id(r) %>" class="px-5 py-3">
          <div class="flex flex-wrap items-center gap-3 text-sm">
            <%= link_to r.scorer.name, scorer_path(r.scorer), class: "text-ink hover:underline decoration-hairline underline-offset-4" %>
            <% if r.scored? %>
              <span class="pill <%= r.passed ? "bg-pale-green text-ink-green" : "bg-pale-red text-ink-red" %>"><%= r.classification %> · <%= r.score %></span>
              <span class="meta"><%= r.passed ? "pass" : "fail" %> · <%= time_ago_in_words(r.scored_at) %> ago</span>
            <% elsif r.status == "queued" %>
              <span class="pill bg-pale-blue text-ink-blue">judging…</span>
            <% else %>
              <span class="pill bg-pale-yellow text-ink-yellow">error</span>
              <span class="meta"><%= r.error.to_s.truncate(120) %></span>
            <% end %>
            <% if r.judge_run %>
              <%= link_to "judge run ##{r.judge_run.id}", run_path(r.judge_run), class: "meta hover:text-ink underline decoration-hairline underline-offset-4" %>
            <% end %>
            <% if r.proposal_id %>
              <%= link_to "proposal ##{r.proposal_id}", proposal_path(r.proposal_id), class: "meta hover:text-ink underline decoration-hairline underline-offset-4" %>
            <% end %>
            <% if run.scorable? %>
              <%= button_to "Re-score", score_run_path(run, scorer_id: r.scorer_id), method: :post, form_class: "inline ml-auto",
                    class: "btn-quiet !py-0.5 !px-2 text-xs" %>
            <% end %>
          </div>
          <% if r.reasoning.present? %>
            <details class="mt-1.5" data-controller="harbor--details"
                     data-action="turbo:before-morph-attribute->harbor--details#preserveOpen"><summary class="meta cursor-pointer">reasoning</summary>
              <p class="text-sm text-body mt-1 whitespace-pre-wrap"><%= r.reasoning %></p></details>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
