<% content_for :title, "New runtime" %>
<%= render "harbor/shared/section_nav" %>
<h1 class="display text-3xl mb-2">New runtime</h1>
<p class="text-sm text-soft mb-8 max-w-2xl">A place work can run. It takes no work until a <%= link_to "workspace", workspace_profiles_path, class: "underline" %> lists it, so adding one changes nothing by itself.</p>

<% backends = Harbor::Runtimes.backend_names.map { |name| [ name, Harbor::Runtimes.backend(name) ] } %>
<%= form_with model: @runtime, scope: :runtime, url: runtimes_path, class: "max-w-3xl space-y-6" do |form| %>
  <% if @runtime.errors.any? %>
    <div role="alert" class="bg-pale-red text-ink-red rounded-lg p-4 text-sm"><%= @runtime.errors.full_messages.join(". ") %></div>
  <% end %>
  <div class="grid sm:grid-cols-2 gap-6">
    <div><%= form.label :name, class: "block text-sm mb-2" %><%= form.text_field :name, required: true, class: "field w-full", placeholder: "Sam's laptop" %></div>
    <div><%= form.label :key, class: "block text-sm mb-2" %><%= form.text_field :key, class: "field w-full font-mono", placeholder: "from the name" %><p class="meta mt-1">Lowercase letters, numbers and dashes. It can't be changed later.</p></div>
    <div>
      <%= form.label :backend, "Backend", class: "block text-sm mb-2" %>
      <%= form.select :backend, backends.map { |name, klass| [ "#{klass.label} (#{name})", name ] }, {}, class: "field w-full" %>
      <p class="meta mt-1">The code that runs work there.</p>
    </div>
    <div><%= form.label :max_concurrent, "Limit", class: "block text-sm mb-2" %><%= form.number_field :max_concurrent, min: 1, required: true, class: "field w-full" %><p class="meta mt-1">Workspaces in use at once.</p></div>
    <div class="sm:col-span-2"><%= form.label :host, class: "block text-sm mb-2" %><%= form.text_field :host, class: "field w-full", placeholder: "Shown beside the runtime; optional" %></div>
  </div>
  <div>
    <%= form.label :config, "Config (JSON)", class: "block text-sm mb-2" %>
    <%= form.text_area :config, value: params.dig(:runtime, :config) || JSON.pretty_generate(@runtime.config.presence || @runtime.backend_class.config_example), rows: 5, class: "field w-full font-mono text-sm" %>
    <dl class="mt-3 space-y-2" data-backend-help>
      <% backends.each do |name, klass| %>
        <% next if klass.config_help.blank? %>
        <div class="text-sm"><dt class="inline font-medium text-ink"><%= klass.label %>:</dt> <dd class="inline text-soft"><%= klass.config_help %></dd></div>
      <% end %>
    </dl>
  </div>
  <label class="text-sm flex gap-2"><%= form.check_box :enabled %> Enabled</label>
  <div class="flex gap-4 items-center"><%= form.submit "Add runtime", class: "btn-primary cursor-pointer" %><%= link_to "Cancel", runtimes_path, class: "text-sm text-soft" %></div>
<% end %>
