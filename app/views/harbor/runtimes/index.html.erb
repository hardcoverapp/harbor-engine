<% content_for :title, "Runtimes" %>
<%= render "harbor/shared/section_nav" %>
<header class="flex flex-wrap justify-between items-start gap-4 mb-10">
  <div><h1 class="display text-3xl">Runtimes</h1><p class="text-sm text-soft mt-2 max-w-3xl">Places a workspace can run, each with a limit. <%= link_to "Workspaces", workspace_profiles_path, class: "underline" %> list them in fallback order. Disabling one moves new workspaces to the next runtime in line; live workspaces finish where they are.</p></div>
  <%= link_to "New runtime", new_runtime_path, class: "btn-primary" %>
</header>

<% if @runtimes.empty? %>
  <p class="text-soft text-sm">No runtimes yet.</p>
<% else %>
  <%# One runtime per row. From md up it is a table; on a phone each row is a
      card of its own, with the columns' names beside their values. %>
  <div class="card overflow-hidden" data-reveal data-controller="harbor--poll" data-harbor--poll-interval-value="30">
    <table class="w-full text-sm text-left">
      <thead class="hidden md:table-header-group border-b border-hairline">
        <tr>
          <% [ "Status", "Runtime", "In use", "Workspaces", "Checked", "" ].each do |heading| %>
            <th scope="col" class="px-5 py-3 meta uppercase tracking-[0.05em] font-medium"><%= heading %></th>
          <% end %>
        </tr>
      </thead>
      <tbody class="divide-y divide-hairline">
        <% @runtimes.each do |runtime| %>
          <% busy = runtime.busy; reason = runtime.unavailable_reason; adapter = runtime.adapter %>
          <% state = !runtime.enabled? ? :off : (reason ? :warning : :ok) %>
          <% notes = adapter.warnings + [ (runtime.last_error.present? && state != :warning ? "Last check failed: #{runtime.last_error}" : nil) ].compact %>
          <tr class="block px-4 py-4 md:table-row md:p-0 align-top" data-runtime="<%= runtime.key %>" data-state="<%= state %>">
            <td class="block md:table-cell md:px-5 md:py-4 md:w-52">
              <span class="inline-flex items-center gap-2 <%= { ok: 'text-ink-green', warning: 'text-ink-yellow', off: 'text-faint' }[state] %>" data-status>
                <%= harbor_icon(state, size: 18) %>
                <span class="font-medium"><%= { ok: "Taking work", warning: "Not taking work", off: "Off" }[state] %></span>
              </span>
              <span class="sr-only" data-health><%= reason ? "Not taking new work: #{reason}" : "Taking new work" %></span>
              <% if state == :warning %><p class="text-xs text-ink-yellow mt-1 [overflow-wrap:anywhere]"><%= reason.to_s.upcase_first %></p><% end %>
            </td>
            <td class="block mt-2 md:mt-0 md:table-cell md:px-5 md:py-4">
              <%= link_to runtime.name, edit_runtime_path(runtime), class: "text-ink font-medium hover:underline decoration-hairline underline-offset-4" %>
              <p class="meta mt-0.5"><%= [ adapter.label, adapter.place ].compact_blank.join(" · ") %></p>
              <% notes.each do |note| %><p class="text-xs text-ink-yellow mt-1 max-w-md [overflow-wrap:anywhere]"><%= note %></p><% end %>
            </td>
            <td class="block mt-2 md:mt-0 md:table-cell md:px-5 md:py-4 md:w-36 whitespace-nowrap">
              <span class="md:hidden meta mr-2">In use</span><span class="text-ink" data-busy><%= busy %> / <%= runtime.max_concurrent %></span>
              <progress class="block w-24 h-1 mt-1.5 accent-[#346538]" max="<%= runtime.max_concurrent %>" value="<%= [ busy, runtime.max_concurrent ].min %>" aria-label="Workspaces in use"></progress>
            </td>
            <td class="block mt-2 md:mt-0 md:table-cell md:px-5 md:py-4 text-body" data-workspaces>
              <span class="md:hidden meta mr-2">Workspaces</span><%= runtime.workspace_profiles.map(&:name).sort.to_sentence.presence || tag.span("None yet", class: "text-faint") %>
            </td>
            <td class="block mt-2 md:mt-0 md:table-cell md:px-5 md:py-4 meta whitespace-nowrap">
              <span class="md:hidden mr-2">Checked</span><%= runtime.checked_at ? "#{time_ago_in_words(runtime.checked_at)} ago" : "Never" %>
            </td>
            <td class="block mt-3 md:mt-0 md:table-cell md:px-5 md:py-4 md:text-right whitespace-nowrap">
              <span class="inline-flex gap-2 items-center">
                <%= link_to "Edit", edit_runtime_path(runtime), class: "btn-quiet !py-1 !px-3 text-xs", "aria-label": "Edit #{runtime.name}" %>
                <%= button_to(runtime.enabled? ? "Disable" : "Enable", runtime_path(runtime), method: :patch,
                      params: { runtime: { enabled: !runtime.enabled? } }, class: "btn-quiet !py-1 !px-3 text-xs", form_class: "inline",
                      "aria-label": "#{runtime.enabled? ? 'Disable' : 'Enable'} #{runtime.name}",
                      data: (runtime.enabled? ? { turbo_confirm: "Disable #{runtime.name}? New workspaces move to the next runtime in each workspace's list." } : {})) %>
              </span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
