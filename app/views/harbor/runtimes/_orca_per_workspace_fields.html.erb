<%# An Orca (per workspace) runtime's fields: which recipe makes the machine.
    Recipes are declared in the host's config file and only chosen here; the
    commands they run are never typed into a page. %>
<% backend = choice.backend_class %>
<% config = chosen ? runtime.config : {} %>
<% value = ->(key) { sent.key?(key) ? sent[key].to_s : config[key.to_s].to_s } %>
<% recipes = backend.recipes %>
<% current = value.(:recipe) %>
<% options = recipes.map { |recipe| [ recipe.name == recipe.id ? recipe.id : "#{recipe.name} · #{recipe.id}", recipe.id ] } %>
<% options += [ [ "#{current} (not declared now)", current ] ] if current.present? && options.none? { |_, id| id == current } %>

<% if backend.recipes_problem.present? %>
  <p class="text-sm text-ink-yellow" data-recipes-problem><%= backend.recipes_problem %></p>
<% elsif recipes.empty? %>
  <p class="text-sm text-ink-yellow" data-recipes-missing><%= backend.unoffered_note %></p>
<% end %>

<div>
  <%= label_tag "#{prefix}[recipe]", "Recipe", class: "block text-sm mb-2" %>
  <%= select_tag "#{prefix}[recipe]", options_for_select(options, current), include_blank: "Choose a recipe…", required: true, class: "field w-full sm:w-96" %>
  <p class="meta mt-1">Declared under <span class="font-mono">environment_recipes</span> in <span class="font-mono"><%= Harbor::ConfigFile.label %></span>. Its create step starts a machine for each run, and its destroy step removes the machine when the run ends.</p>
</div>

<details class="text-sm">
  <summary class="text-soft cursor-pointer">Advanced</summary>
  <div class="mt-4 space-y-6">
    <div>
      <%= label_tag "#{prefix}[setup]", "The repository's setup hooks", class: "block text-sm mb-2" %>
      <%= select_tag "#{prefix}[setup]", options_for_select(backend::SETUPS.invert.to_a, value.(:setup).presence || "skip"), class: "field w-full sm:w-96" %>
      <p class="meta mt-1">Whether a new worktree runs the setup script the repository has in Orca.</p>
    </div>
  </div>
</details>
