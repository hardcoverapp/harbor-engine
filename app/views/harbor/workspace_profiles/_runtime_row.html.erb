<div class="card p-5 grid sm:grid-cols-6 gap-4 items-end" data-harbor-nested-row>
  <%= form.hidden_field :id %>
  <div class="sm:col-span-3"><%= form.label :runtime_id, "Runtime", class: "block text-xs text-soft mb-2" %><%= form.collection_select :runtime_id, Harbor.runtime_class.ordered, :id, ->(r) { "#{r.name}#{' (disabled)' unless r.enabled?}" }, { include_blank: "Choose a runtime" }, required: true, class: "field w-full" %></div>
  <div><%= form.label :position, "Priority", class: "block text-xs text-soft mb-2" %><%= form.number_field :position, min: 0, required: true, class: "field w-full" %></div>
  <div class="flex gap-2 sm:col-span-2">
    <button type="button" class="btn-quiet" data-action="harbor--nested-fields#moveUp" aria-label="Move up">↑</button>
    <button type="button" class="btn-quiet" data-action="harbor--nested-fields#moveDown" aria-label="Move down">↓</button>
  </div>
  <label class="text-xs text-soft flex gap-2 sm:col-span-6"><%= form.check_box :_destroy %> Remove this runtime when saved</label>
</div>
