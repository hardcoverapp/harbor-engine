<%# One number for each thing Harbor keeps (Harbor::Overview::Summary), and
    the host's own tiles. locals: snapshot. %>
<% tiles = Harbor::Overview::Summary.new(since: snapshot.since).tiles %>
<% if tiles.any? %>
  <section id="at-a-glance" class="mb-14" data-reveal>
    <h2 class="display text-xl mb-4">At a glance <span class="meta">· last <%= Harbor::Overview::WINDOW.in_days.round %> days</span></h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <% tiles.each do |tile| %>
        <article class="card p-5" data-tile="<%= tile.key %>">
          <div class="meta uppercase tracking-[0.05em]"><%= tile.label %></div>
          <div class="display text-3xl mt-1"><%= tile.url ? link_to(tile.value, tile.url, class: "hover:underline") : tile.value %></div>
          <% if tile.note.present? %><div class="meta mt-1"><%= tile.note %></div><% end %>
        </article>
      <% end %>
    </div>
  </section>
<% end %>
