<%# Everything a person can do and what it causes, as the host declared it
    (Harbor::Overview.steer). %>
<% rows = Harbor::Overview.steering %>
<% if rows.any? %>
<section id="how-to-steer" class="mb-14" data-reveal>
  <h2 class="display text-xl mb-2">How to steer</h2>
  <p class="text-sm text-soft mb-4 max-w-2xl">Everything a person can do, and what it causes.</p>
  <div class="lg:overflow-x-auto">
    <table role="table" class="block lg:table w-full text-sm lg:bg-surface lg:border border-hairline lg:rounded-xl">
      <thead class="hidden lg:table-header-group text-left">
        <tr class="border-b border-hairline">
          <th class="px-5 py-3 meta uppercase tracking-[0.05em] font-medium">You want to…</th>
          <th class="px-5 py-3 meta uppercase tracking-[0.05em] font-medium">Do this</th>
          <th class="px-5 py-3 meta uppercase tracking-[0.05em] font-medium">What happens</th>
          <th class="px-5 py-3 meta uppercase tracking-[0.05em] font-medium">Stage</th>
        </tr>
      </thead>
      <tbody class="grid gap-4 lg:table-row-group lg:divide-y lg:divide-hairline">
        <% rows.each do |row| %>
          <% stage = Harbor::Overview.find_stage(row.stage) %>
          <tr id="steer-<%= row.key %>" class="grid gap-2 p-5 border border-hairline rounded-xl bg-surface lg:table-row lg:p-0 lg:border-0 lg:rounded-none">
            <td class="block lg:table-cell lg:px-5 lg:py-3 text-ink font-medium"><%= row.want %></td>
            <td class="block lg:table-cell lg:px-5 lg:py-3 text-body"><%= harbor_inline_markdown(row.action) %></td>
            <td class="block lg:table-cell lg:px-5 lg:py-3 text-soft"><%= harbor_inline_markdown(row.result) %></td>
            <td class="block lg:table-cell lg:px-5 lg:py-3 meta">
              <%= stage ? link_to(stage.title, "##{stage.anchor}", class: "hover:text-ink") : row.stage %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
<% end %>
