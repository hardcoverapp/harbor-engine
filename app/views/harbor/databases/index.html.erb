<% content_for :title, "Databases" %>
<%= render "harbor/shared/section_nav" %>
<header class="flex flex-wrap justify-between items-start gap-4 mb-8">
  <div>
    <h1 class="display text-3xl">Databases</h1>
    <p class="text-sm text-soft mt-2">Greenmask backups, full and masked, plus staging refreshes.</p>
  </div>
  <% if @operations_available %><%= button_to "Back up all databases", backup_all_databases_path, class: "btn-primary" %><% end %>
</header>

<%= render "harbor/shared/page_tabs", label: "Databases", tabs: [
      [ "Databases", databases_path, @tab == :databases ],
      [ "Recent operations", databases_path(tab: "operations"), @tab == :operations ] ] %>

<% if @tab == :operations %>
  <%= render "harbor/databases/operations" %>
<% else %>
  <%= render "harbor/databases/databases" %>
<% end %>
